Options -Indexes
DirectorySlash Off

RewriteEngine On
RewriteRule ^(imagesafe|contact|privacy|terms)/?$ $1/index.html [L]

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Never let browsers or Cloudflare keep a "not found": a file missing for a moment
# (mid-deploy) must not stay missing once it arrives.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} == 404 || %{REQUEST_STATUS} == 403"
</IfModule>

<Files "_lib.php">
    Require all denied
</Files>
